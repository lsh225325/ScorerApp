@page "/room/{roomid}"
@page "/room/{roomid}/{create}"

@using Microsoft.AspNetCore.SignalR.Client
@using ScorerApp.Components.Account
@attribute [Authorize]
@inject RoomService roomService
@inject UserManager<ApplicationUser> userManager
@inject ScoreService scoreService
@inject NavigationManager Navigation
@inject DialogService dialogService
@inject UserService userService
@inject IdentityRedirectManager redirectManager
@rendermode InteractiveServer
@implements IAsyncDisposable

<PageTitle>好手气·房间代码：@room!.Code</PageTitle>

<!----Modal------>
<ModalComponent Show="showModal" OnClose="HideModal">
    <div class="row justify-content-center" style="height:500px">
        <div class="col-md-6 align-content-center justify-content-center">
            <h1 class="text-center">给分</h1>
            <div class="rz-text-align-center" style="margin-top:60px">
                @* <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H3">手动输入</RadzenText> *@
                <RadzenNumeric Min="1" Max="1000" @bind-Value=@addScore Placeholder="输入分数"
                               class="text-center" Style="width:80%;height:50px;" />
            </div>
            <div class="rz-text-align-center" style="margin-top:60px">
                <RadzenSlider Value=@(addScore<11 ?addScore:10) TValue="int" Min="1" Max="10" Style="width:80%;height:50px"
                              Change="@(args =>addScore = args)" />
            </div>
            <div class="rz-text-align-center" style="margin-top:60px">
                <RadzenButton Variant="Variant.Flat" Style="width:80%" Text="给分" Size="ButtonSize.Large" Icon="add"
                              class="rz-border-radius-6" ButtonStyle="ButtonStyle.Info"
                              Click=@( async () =>{ await AddScore(); HideModal();} )>
                </RadzenButton>
            </div>
        </div>
    </div>
</ModalComponent>



<div class="row flex justify-content-center" style="padding-top:0px">
    <div class="col-md-6">
        <div class="row-cols-1">


            <RadzenButton Size="ButtonSize.Small" Shade="Shade.Darker" Variant="Variant.Outlined"
                          class="rz-border-radius-6 " ButtonStyle="ButtonStyle.Dark"
                          Click="@ShareRoom">
                <RadzenLabel> 房间号：@room!.Code</RadzenLabel> · 点击分享
            </RadzenButton>
        </div>

        <MyComponent my=my />

        <table class="table align-content-center text-white">
            <thead>
                <tr>
                    <th class="col-4">玩家</th>
                    <th>加入时间</th>
                    <th>得分</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in players!)
                {
                    if (item.UserId == userId) continue;
                    <tr>
                        <td>
                            <RadzenImage Path="@item.HeadImgUrl" Style="width: 30px; height: 30px; border-radius: 50%;" />
                            <a class="text-center">@item.NickName</a>
                        </td>
                        <td class="flex align-content-center">
                            @item.Created.ToString("yyyy/MM/dd HH:mm:ss", CultureInfo.InvariantCulture)
                        </td>
                        <td class="flex flex-column align-content-center">
                            @item.Score
                        </td>
                        <td class="flex align-content-center">
                            <RadzenButton Shade="Shade.Dark" Variant="Variant.Filled"
                                          Click=@(()=>{ShowModal();addScore=1;fromUserId=item.UserId!;})
                                          class="rz-border-radius-6 justify-content-center" ButtonStyle="ButtonStyle.Info">
                                <b>给分</b>
                            </RadzenButton>
                        </td>
                    </tr>
                }
            </tbody>
        </table>


        <div style="padding-top:20px">
            <ScoreItemPage items=@(scoreItems!.Where(o=>o.UserId==userId).ToList()) />
        </div>
    </div>
</div>

@code {

    //modal初始状态为隐藏
    private bool showModal = false;

    //给分者为空
    private string fromUserId = "";

    //给分分数=1
    private int addScore = 1;

    //显示modal
    private void ShowModal() => showModal = true;

    //隐藏modal
    private void HideModal()
    {
        //隐藏时，清空fromuserId，初始化addScore
        fromUserId = "";
        addScore = 1;
        showModal = false;
    }

    /// <summary>
    /// 设置房间信息
    /// </summary>
    [Parameter] public string roomId { get; set; }
    [Parameter] public string? create { get; set; }
    public Room? room = new();


    private string userId = "";
    private string nickName = "";
    private string errorMsg = "";
    private MyInfo my = new();
    private List<MyInfo> players = new();
    private List<ScoreItem>? scoreItems;

    private HubConnection? hubConnection;

    [CascadingParameter]
    private Task<AuthenticationState>? authenticationState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await GetUserId();
        if (string.IsNullOrEmpty(userId) || string.IsNullOrEmpty(roomId)) return;

        //加入房间
        await roomService.JoinGame(roomId, userId);

        //获取玩家列表，并更新my的数据
        await GetPlayers();

        //如果没有设置昵称，跳转修改昵称
        if (string.IsNullOrEmpty(my.NickName) || my.NickName == "点我修改")
            Navigation.NavigateTo($"/updatenickname?ReturnUrl=/room/{roomId}", true);

        //获取房间信息
        room = await roomService.GetRoomAsync(roomId);

        //获取得分记录
        scoreItems = await scoreService.GetItemsByRoomId(roomId);

        //计算玩家得分
        if (scoreItems.Count > 0) MathPlayerScore(scoreItems);

        //创建hub连接
        hubConnection = new HubConnectionBuilder().WithUrl(Navigation.ToAbsoluteUri("/SignHub")).Build();
        hubConnection.On("SendMessage", async () =>
        {
            await GetPlayers();
            scoreItems = await scoreService.GetItemsByRoomId(roomId);
            MathPlayerScore(scoreItems);

            await InvokeAsync(StateHasChanged);
        });
        await hubConnection.StartAsync();

    }

    //在渲染后执行
    //如果create=create，则表示是新建房间，弹出一个modal，提示玩家房间分享的方式
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        await base.OnAfterRenderAsync(firstRender);
        if (create == "create")
        {
            await ShareRoom();
        }
    }

    //获取用户id
    private async Task GetUserId()
    {
        if (authenticationState is not null)
        {
            var authState = await authenticationState;
            var user = authState?.User;

            if (user?.Identity is not null && user.Identity.IsAuthenticated)
            {
                userId = user.FindFirstValue(ClaimTypes.NameIdentifier)!;
            }
        }
    }

    //添加分数
    private async Task AddScore()
    {
        // 检查分数是否合法
        if (addScore < 1 || addScore > 1000) return;

        // 检查用户是否是当前用户，防止自己给自己加分
        if (fromUserId == userId) return;

        // 添加分数，确保在数据库层面进行适当的参数化查询以防止 SQL 注入攻击
        await scoreService.AddScore(userId, roomId, addScore, fromUserId);

        // 更新分数列表
        scoreItems = await scoreService.GetItemsByRoomId(roomId);
        MathPlayerScore(scoreItems);

        // 发送消息通知其他客户端更新
        if (hubConnection is not null)
        {
            await hubConnection.SendAsync("SendMessage");
        }

        // 触发 UI 更新
        StateHasChanged();
    }

    //计算玩家得分
    private void MathPlayerScore(List<ScoreItem> items)
    {
        foreach (var player in players)
        {
            player.Score = items
    .Where(c => c.UserId == player.UserId)
    .Sum(o => o.Score);
        }
    }

    //获取玩家列表
    private async Task GetPlayers()
    {
        var py = await roomService.GetPlayersByRoom(roomId);
        players = py.Select(p => new MyInfo
            {
                UserId = p.UserId,
                NickName = p.User!.NickName,
                HeadImgUrl = string.IsNullOrEmpty(p.User.HeadImgUrl) ? "/favicon.png" : p.User.HeadImgUrl,
                Created = p.CreateTime
            }).ToList();
        my = players.FirstOrDefault(c => c.UserId == userId)!;
    }

    //释放资源
    public async ValueTask DisposeAsync()
    {
        if (hubConnection is not null)
        {
            await hubConnection.DisposeAsync();
        }
    }

    //更新昵称
    private async Task UpdateNickName()
    {
        if (string.IsNullOrEmpty(nickName) || nickName.Length < 2)
        {
            errorMsg = "至少输入两个字";
            return;
        }
        await userService.UpdateNickName(userId, nickName);
        errorMsg = "";
        StateHasChanged();
    }


    private async Task ShareRoom()
    {
        // await dialogService.OpenAsync<CreateViewShareWay>("分享房间",
        // new Dictionary<string, object>() { { "roomId", roomId }, { "Uri", Navigation.Uri} },
        // new DialogOptions() { });
        await dialogService.OpenAsync<CreateViewShareWay>("分享房间",
              new Dictionary<string, object>() { { "roomNo", room!.Code }, { "uri", Navigation.Uri } },
              new DialogOptions()
              { });

    }


}
