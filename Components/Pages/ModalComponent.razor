<!-- ModalComponent.razor -->
<!-- 通用的弹出对话框 -->
<!-- 使用时，填入html内容 -->

<div class="modal" style="display:@Display">
    <div class="modal-content">
        <span class="close" @onclick="Close">&times;</span>
        @ChildContent
    </div>
</div>


<style>
    .modal {
        display: none;
        position: fixed;
        z-index: 999;
        left: 0;
        top: 0;
        width: 100%;
    }

    .modal-content {
        background-color:black;
        padding: 0px;
        width: 100%;
    }

    .close {
        color: #aaa;
        float: right;
        font-size: 60px;
        font-weight: bold;
    }

        .close:hover,
        .close:focus {
            color: black;
            text-decoration: none;
            cursor: pointer;
        }

</style>


@code {
    [Parameter]
    public RenderFragment ChildContent { get; set; }

    [Parameter]
    public bool Show { get; set; }

    private string Display => Show ? "block" : "none";

    [Parameter]
    public EventCallback OnClose { get; set; }

    private async Task Close()
    {
        if (OnClose.HasDelegate)
        {
            await OnClose.InvokeAsync(null);
        }
    }

}