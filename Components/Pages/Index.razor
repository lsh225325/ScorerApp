@page "/"

@inject NavigationManager navigationManager
@inject DialogService dialogService

<PageTitle>好手气·打牌记分</PageTitle>

<div class="row flex justify-content-center">
    <div class="col-md-6">
        <div class=" row text-center align-content-center justify-content-center" style="height:250px">
            <a href="/home" style="text-decoration:none">
                <RadzenImage Path="./logo400.png" Style="width: 300px;" />
            </a>
            <h2>好手气·打牌记分</h2>
        </div>
        <RadzenButton Size="ButtonSize.Large" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Info"
                      Icon="add" class="rz-border-radius-10 rz-my-1" style="width:100%;height:100px;"
                      Text="新建一个房间"
                      Click="@CreateRoom" />

        <RadzenButton Size="ButtonSize.Large" Variant="Variant.Flat" ButtonStyle="ButtonStyle.Success"
                      Icon="check_circle" class="rz-border-radius-10 rz-my-1" style="width:100%;height:100px;"
                      Text="加入房间"
                      Click="@JoinGame" />

    </div>
</div>


@code {

    private async Task CreateRoom()
    {
        await dialogService.OpenAsync<CreatRoom>("");        
    }

    private async Task JoinGame()
    {
        await dialogService.OpenAsync<JoinGame>("");
    }

}