@inject NavigationManager NavigationManager;
@inject DialogService dialogService;
@inject IJSRuntime JSRuntime;
@attribute [Authorize]

<PageTitle>好手气·房间分享方式</PageTitle>

<div class="row justify-content-center" style="height:350px">
    <div class="col-md-8 align-content-center">
        <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H4" class="text-center">房间已成功建立！</RadzenText>
        <div class="form-floating mb-3">
            <RadzenCard Variant="Variant.Flat">
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H5">方式一：发送房间号：“ @roomNo ”给朋友</RadzenText>
                <RadzenToggleButton @bind-Value=@value Change=@CopySerialNumber Text="@(value ? "已复制" : "复制房间号" )"
                                    Shade="Shade.Darker" ButtonStyle="ButtonStyle.Info" ToggleButtonStyle="ButtonStyle.Success"
                                    class="rz-border-radius-6 rz-my-1" />
            </RadzenCard>
        </div>
        <div class="form-floating mb-3">
            <RadzenCard Variant="Variant.Flat">
                <RadzenText TextStyle="TextStyle.Subtitle2" TagName="TagName.H5">方式二：</RadzenText>
                <RadzenButton Shade="Shade.Darker" Variant="Variant.Flat" class="rz-border-radius-6 rz-my-1"
                              Click="@SharePage"
                              Text="点击分享这个页面" ButtonStyle="ButtonStyle.Info" />
                <RadzenTextBox Value="@uri" aria-label="TextBox with placeholder" />
            </RadzenCard>
        </div>

   
    <RadzenStack Orientation="Orientation.Horizontal" JustifyContent="JustifyContent.Center" Gap="0.5rem">
        <RadzenButton Click="@((args) => dialogService.Close(true))"  Text="取消"
                          Shade="Shade.Darker" ButtonStyle="ButtonStyle.Info" Variant="Variant.Outlined"
                          class="rz-border-radius-6 rz-my-1" Style="width: 80%" />
    </RadzenStack>

    </div>
</div>


@code {
    [Parameter] public string roomNo { get; set; } = "";
    [Parameter] public string uri { get; set; } = "";

    bool value;

    private async Task SharePage()
    {
        //将uri中的"/create"替代为空
        uri = uri.Replace("/create", "");
        await JSRuntime.InvokeVoidAsync("sharePage", uri);
    }

    private async Task CopySerialNumber()
    {
        await JSRuntime.InvokeVoidAsync("copyToClipboard", roomNo);
    }
}
